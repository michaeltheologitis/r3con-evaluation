borne_by": null, "recipient": null}, {"amount": "753618.16 元", "purpose": "孙某 2 和孙某 3 继承份额", "borne_by": null, "recipient": "孙某 2"}, {"amount": "1004824.21 元", "purpose": "孙某 1 继承份额", "borne_by": null, "recipient": "孙某 1"}, {"amount": "500 元", "purpose": "Land Lease Fee Standard", "borne_by": "某农业发展公司", "recipient": "呼图壁县农场管理局"}, {"amount": "115,000,000 元", "purpose": "Land Contract Fee", "borne_by": "呼图壁县农场管理局", "recipient": "某农业发展公司"}, {"amount": "324,100 元", "purpose": "Land Lease Fee", "borne_by": "李某", "recipient": "某农业发展公司"}], "verdicts": [{"action": "不予支持", "outcome": "驳回申诉请求", "quote": "综上所诉，申诉人周某的申诉理由不能成立，本院对其申诉请求不予支持。"}, {"action": "驳回上诉", "outcome": "维持原判", "quote": "综上所述，十九局二公司的上诉请求不能成立，应予驳回；一审判决认定事实清楚，适用法律正确，应予维持。"}, {"action": "判决支付", "outcome": "支付工程劳务施工款及利息", "quote": "一、十九局二公司于判决生效之日起 30 日内向袁中华支付工程劳务施工款 21,015,378 元及利息..."}, {"action": "一审判决", "outcome": "一、修复防水；二、修复损害；三、支付租房损失；四、支付鉴定费；五、驳回其他请求", "quote": "一、广州珠江钢铁有限责任公司在判决生效之日起三十日内对广州市黄埔区天虹街 15 号之一 401 房的防水失效部位进行修复，以排除对广州市黄埔区天虹街 15 号之一 301 房的妨害；\n二、广州珠江钢铁有限责任公司在判决生效之日起三十日内对广州市黄埔区天虹街 15 号之一 301 房客厅天花板底抹灰渗水发霉和开裂脱落，厨房天花板板底抹灰渗水发霉和开裂脱落，卫生间天花板板底面抹灰有受潮发霉，阳台天花板板底抹灰受潮发霉及开裂脱落等损害进行修复，使其恢复原状；\n三、广州珠江钢铁有限责任公司在判决生效之日起十日内向黄新艳支付租房损失 15000 元；\n四、广州珠江钢铁有限责任公司于判决生效之日起十日内向黄新艳支付鉴定费 23800 元；\n五、驳回黄新艳的其他诉讼请求。"}, {"action": "二审裁定", "outcome": "驳回上诉，维持原判", "quote": "综上所述，黄新艳、广州珠江钢铁有限责任公司的上诉请求不能成立，应予驳回；一审判决认定事实清楚，适用法律正确，应予维持。"}, {"action": "驳回", "outcome": "驳回原告韩文强韩某某的诉讼请求", "quote": "一审判决依照《中华人民共和国专利法》...之规定，判决：'驳回原告韩文强韩某某的诉讼请求。'"}, {"action": "维持原判", "outcome": "上诉请求不予支持", "quote": "故对韩文强韩某某的上诉请求不予支持... 本院予以维持"}, {"action": "准许", "outcome": "撤回管辖权异议上诉", "quote": "上诉人撤回管辖权异议上诉，不违反法律规定，本院予以准许。"}, {"action": "驳回", "outcome": "不予执行申请", "quote": "（2021）辽 02 执异 138 号执行裁定，驳回刘某琴的不予执行申请"}, {"action": "驳回", "outcome": "复议请求，维持原裁定", "quote": "（2021）辽执复 259 号执行裁定，驳回刘某琴复议请求，维持大连中院（2021）辽 02 执异 138 号执行裁定"}, {"action": "撤销、发回", "outcome": "执行裁定", "quote": "（2022）辽执监 214 号执行裁定，撤销大连中院及本院的执行裁定，发回大连中院重新审查"}, {"action": "不予执行", "outcome": "仲裁调解书第三项", "quote": "（2023）辽 02 执异 14 号执行裁定书... 不予执行 [2021] 大仲字第 199 号仲裁调解书第三项"}, {"action": "驳回", "outcome": "复议申请，维持裁定", "quote": "（2023）辽执复 84 号执行裁定书，驳回朱某的复议申请，维持大连中院（2023）辽 02 执异 14 号执行裁定"}, {"action": "一审判决", "outcome": "房屋归各方所有，驳回其他诉讼请求", "quote": "一、坐落于上海市崇明区 XX 号主房占地面积 107.8 平方米的房屋，朝东向一间三层楼房归丁某 1 所有，朝南向西首两上两下房屋归丁某 2 所有，朝南向东首一上一下房屋归丁某 3 所有（楼梯间由丁某 1、丁某 2、丁某 3 共同使用）；二、驳回丁某 1 其余的诉讼请求。"}, {"action": "二审判决", "outcome": "驳回上诉，维持原判", "quote": "丁某 1 的上诉请求不能成立，本院不予支持；一审法院认定事实清楚，适用法律正确，本院予以维持。"}, {"action": "确认", "outcome": "驳回起诉", "quote": "原审法院裁定驳回其起诉，理由虽有不当，但结果正确，本院予以确认。"}, {"action": "一审判决", "outcome": "停止侵权、赔偿 6.5 万元、驳回其他", "quote": "判决：一、龙港市某工艺品厂立即停止许诺销售、销售侵害深圳某科技有限公司享有的专利号为 201910759811.2、名称为“一种具有伸缩和收纳功能的折叠装置及其折叠风扇”的发明专利权产品；二、龙港市某工艺品厂于判决生效后三日内赔偿深圳某科技有限公司经济损失 6.5 万元（含深圳某科技有限公司合理维权费用）；三、驳回深圳某科技有限公司的其他诉讼请求。"}, {"action": "二审法院认定", "outcome": "合法来源抗辩不成立，调整赔偿数额", "quote": "本院综合考虑涉案发明专利权的类型、创新程度、被诉侵权产品的价格、利润率，并结合某科技公司在全国范围内的批量维权情况等因素，酌定某工艺品厂应赔偿某科技公司经济损失的数额为 2 万元。关于合理开支，... 本院酌情确定某工艺品厂应向某科技公司赔偿维权合理开支 500 元。"}, {"action": "二审法院意见", "outcome": "维持一审关于侵权和合法来源不成立的认定，调整赔偿额", "quote": "一审法院关于被诉侵权产品的来源的相关认定有误，本院予以纠正，但关于合法来源抗辩不成立的相关认定结论正确，本院予以确认。"}, {"action": "驳回", "outcome": "申诉", "quote": "决定如下"}, {"action": "判决", "outcome": "二审改判，确认账户余额归吴某 2 所有，吴某 2 补偿吴某 1262869.54 元；确认丧葬费及抚恤金分配无异议", "quote": "故本院确认吴某芳名下中国工商银行账号 36×××32 的账户余额归吴某 2 所有，由吴某 2 向吴某 1 补偿 262869.54 元。"}, {"action": "驳回", "outcome": "再审申请", "quote": "对其再审主张，本院不予支持。"}, {"action": "改判", "outcome": "上诉请求部分成立，予以支持", "quote": "一审判决认定事实不清，对死亡赔偿金分配不当，应予改判。张某龙、刘某华的上诉请求部分成立，予以支持。"}, {"action": "驳回", "outcome": "杨某平、张某龙、刘某华共同支付张某国 32,800 元", "quote": "张某国应得死亡赔偿金数额 32,800 元，应由杨某平、张某龙、刘某华共同支付。"}, {"action": "维持", "outcome": "驳回上诉，维持原判", "quote": "本院认为，上诉人的上诉请求，缺乏依据，不予支持。一审判决认定事实清楚，适用法律正确，予以维持。"}, {"action": "驳回上诉，维持原判", "outcome": "维持一审民事判决", "quote": "美卡公司甲公司的上诉请求不能成立，应予驳回；一审判决认定事实清楚，适用法律正确，应予维持。"}, {"action": "驳回", "outcome": "驳回上诉，维持原判", "quote": "陈某、彭某的上诉请求不能成立，应予以驳回；一审判决认定事实清楚，适用法律正确，应予维持。"}, {"action": "一审判决", "outcome": "确认房产由陈某、彭某、杜某、陈某 2 四人均等继承，拍卖房产偿还贷款后剩余款项均分", "quote": "一、确认广州市黄埔区文宝街 x 号xxxx房产权...由陈某、彭某、杜某、陈某 2 四人均等继承...；二、在判决生效之日起六十日内，陈某、彭某、杜某、陈某 2 可向一审法院申请拍卖或变卖上述涉案房产...；三、驳回陈某、彭某的其他诉讼请求。"}, {"action": "不支持", "outcome": "再审理由不成立", "quote": "康平县政府申请再审的理由不符合《中华人民共和国行政诉讼法》第九十一条规定的再审条件。... 本院对其再审请求依法不予支持"}, {"action": "支付", "outcome": "维持原判（驳回上诉）", "quote": "判决如下：... 判决：一、某某村合作社于判决生效之日起十日内支付王某某 2370 元；二、某某村合作社于判决生效之日起十日内支付林某某 2370 元；三、驳回王某某与林某某其他诉讼请求。案件受理费 50 元，由某某村合作社承担。"}, {"action": "驳回上诉", "outcome": "驳回上诉，维持原判", "quote": "综上，王某某、林某某与某某村合作社的上诉请求均不能成立，本院均予以驳回。"}, {"action": "驳回上诉，维持原判", "outcome": "一审判决认定事实清楚，适用法律正确，予以维持", "quote": "李某锋、梁某其、欧某好的上诉理由均不成立，其上诉请求均应予驳回。审查一审认定事实清楚，适用法律正确，应予维持。"}, {"action": "变更", "outcome": "重新确定继承份额", "quote": "本院据此对被继承人周玉彦的遗产重新确定继承份额如下：1.坐落广州市海珠区南箕××××房由潘某 2、潘某 3 和潘某 1 各继承四分之一产权份额，由游某继承八分之一产权份额，由潘某 4 继承八分之一产权份额。2.被继承人周玉彦原医保账户余额 22504.38 元由潘某 2、潘某 3 和潘某 1 各继承四分之一份额，由游某继承八分之一份额，由潘某 4 继承八分之一份额。"}, {"action": "判决", "outcome": "一审判决结果", "quote": "一、坐落广州市海珠区南箕××××房由潘某 2、潘某 3、潘中一和潘某 1 各继承四分之一产权份额。潘某 2、潘某 3、潘中一和潘某 1 互负协助对方办理产权变更登记手续义务；二、被继承人周玉彦原医保账户余额 22504.38 元由潘某 2、潘某 3、潘中一和潘某 1 各继承四分之一份额。潘某 2在判决发生法律效力之日起三日内将 5626.09 元给付潘某 1；三、驳回潘某 2、潘某 3、潘中一的其他诉讼请求。"}, {"action": "裁定", "outcome": "不符合再审情形", "quote": "周某、黄某某的再审申请不符合《中华人民共和国民事诉讼法》第二百一十一条规定的再审情形"}, {"action": "驳回上诉，维持原判", "outcome": "维持原判", "quote": "综上，夏某1的上诉理由不能成立，予以驳回。原判认定事实清楚，适用法律正确，实体处理得当，予以维持。"}, {"action": "采纳", "outcome": "公诉机关的量刑建议适当", "quote": "公诉机关的量刑建议适当，本院予以采纳"}, {"action": "支持", "outcome": "承担失火造成的期间损害价值和生态修复费用", "quote": "公益诉讼起诉人依法向本院提起刑事附带民事公益诉讼，要求覃某昌承担失火造成的期间损害价值和生态修复费用 54,996.03 元... 本院予以支持"}, {"action": "支持", "outcome": "公开赔礼道歉", "quote": "并要求公开赔礼道歉的诉讼请求，符合法律规定且有相关证据证实，本院予以支持"}, {"action": "驳回", "outcome": "再审申请", "quote": "某某万科分店的再审申请不符合《中华人民共和国民事诉讼法》第二百一十一条规定的再审情形"}, {"action": "驳回", "outcome": "申诉理由不能成立", "quote": "故你的此节申诉理由亦不能成立。"}, {"action": "驳回上诉", "outcome": "维持原判", "quote": "刘某的上诉请求不能成立，应予驳回；一审判决认定事实清楚，适用法律正确，应予维持。"}, {"action": "驳回上诉，维持原判", "outcome": "一审判决认定事实清楚，适用法律正确，程序合法，应予维持", "quote": "本院认为，...一审判决认定事实清楚，适用法律正确，程序合法，应予维持。综上所述，孙某 1 的上诉请求不能成立，应予驳回"}, {"action": "分割遗产", "outcome": "孙某 1 继承取得 40%，孙某 2、孙某 3 各继承取得 30%", "quote": "一审法院于 2023 年 12 月 26 日判决如下：一、被继承人孙某栋建设银行...；二、被继承人夏某...；三、孙某 3 保管的...和孙某 1 保管的...；四、驳回...其他诉讼请求"}], "case_refs": [{"number": "（2021）皖执复 148 号", "court": "安徽省高级人民法院"}, {"number": "（2021）皖 01 执异 63 号", "court": "安徽省合肥市中级人民法院"}, {"number": "（2015）合执字第 00095-7 号", "court": "安徽省合肥市中级人民法院"}, {"number": "（2015）合执字第 00095-5 号", "court": "安徽省合肥市中级人民法院"}, {"number": "（2014）合民一初字第 00718 号", "court": "安徽省合肥市中级人民法院"}, {"number": "（2015）合执字第 00095-3 号", "court": "安徽省合肥市中级人民法院"}, {"number": "（2015）合执字第 00095-4 号", "court": "安徽省合肥市中级人民法院"}, {"number": "（2018）云刑终 13 号", "court": "云南省高级人民法院"}, {"number": "（2018）云 25 执恢 190 号", "court": "云南省红河哈尼族彝族自治州中级人民法院"}, {"number": "（2016）云 25 刑初 149 号", "court": "云南省红河哈尼族彝族自治州中级人民法院"}, {"number": "(2019) 藏民初 8 号", "court": "西藏自治区高级人民法院"}, {"number": "(2020) 最高法民终 427 号", "court": "最高人民法院"}, {"number": "(2021) 藏民初 3 号", "court": "西藏自治区高级人民法院"}, {"number": "(2020) 最高法民终 428 号", "court": "最高人民法院"}, {"number": "(2019) 藏民初 21 号", "court": "西藏自治区高级人民法院"}, {"number": "（2022）粤 0112 民初 21026 号", "court": "广州市黄埔区人民法院"}, {"number": "(2021) 鲁 01 知民初 402 号", "court": "山东省济南市中级人民法院"}, {"number": "(2018) 鲁 01 民初 1059 号", "court": "山东省济南市中级人民法院"}, {"number": "(2020) 最高法知民终 1148 号", "court": "最高人民法院"}, {"number": "(2018) 鲁聊城鲁西证民字第 1843 号", "court": "山东省聊城市鲁西公证处"}, {"number": "（2023）渝 01 民初 866 号", "court": "重庆市第一中级人民法院"}, {"number": "（2023）新 40 行初 20 号", "court": "新疆维吾尔自治区高级人民法院伊犁哈萨克自治州分院"}, {"number": "（2023）辽 02 执异 1076 号", "court": "大连市中级人民法院"}, {"number": "[2021] 大仲字第 199 号", "court": "大连仲裁委员会"}, {"number": "（2021）辽 02 执异 138 号", "court": "大连市中级人民法院"}, {"number": "（2021）辽执复 259 号", "court": "辽宁省高级人民法院"}, {"number": "（2022）辽执监 214 号", "court": "辽宁省高级人民法院"}, {"number": "（2018）辽 0203 民初 5313 号", "court": "大连市西岗区人民法院"}, {"number": "（2019）辽 0203 执 329 号", "court": "大连市西岗区人法院"}, {"number": "（2017）辽 0202 执 322