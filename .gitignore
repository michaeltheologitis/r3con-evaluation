# Python caches
__pycache__/
.pytest_cache/
*.py[cod]

# Virtual environments
.venv/

# Notebook artifacts
.ipynb_checkpoints/

# analysis/ writes each figure twice: the PDF is the paper's, the PNG is a local check render
analysis/figures/**/*.png

.env

# Run outputs stay untracked — the logs that reproduce the paper ship COMPRESSED, as
# logs.tar.zst at the repo root, because the loose tree is 176k tiny files (62 MB of content
# but ~750 MB once every file takes a disk block). Unpack it with `tar -xf logs.tar.zst`.
logs/*
!logs/.gitkeep

# setuptools editable-install metadata (regenerated by `uv pip install -e .`)
*.egg-info/
# Local scratch notes (cluster/vLLM commands) — not part of the repo
help.txt

# per-method paper PDFs — kept locally, never tracked (by design)
evals/baselines/*/*.pdf

# Python build artifacts
build/
dist/
*.egg-info/

# macOS Finder metadata
.DS_Store

# Agent / working-process files — local only, not part of the artifact
CLAUDE.md
STATUS.md
AGENTS.md
.claude/
.cursor/
.aider*
