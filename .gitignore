# Python caches
__pycache__/
.pytest_cache/
*.py[cod]

# Virtual environments
.venv/

# Notebook artifacts
.ipynb_checkpoints/

.env

# Run outputs — kept local only (don't bloat clones / installs); the empty dir is tracked
logs/*
!logs/.gitkeep

# setuptools editable-install metadata (regenerated by `uv pip install -e .`)
*.egg-info/
# Local scratch notes (cluster/vLLM commands) — not part of the repo
help.txt

# per-method paper PDFs — kept locally, never tracked (by design)
evals/baselines/*/*.pdf

# Python build artifacts
build/
dist/
*.egg-info/

# macOS Finder metadata
.DS_Store

# Agent / working-process files — local only, not part of the artifact
CLAUDE.md
STATUS.md
AGENTS.md
.claude/
.cursor/
.aider*
