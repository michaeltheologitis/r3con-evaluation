# Python caches
__pycache__/
.pytest_cache/
*.py[cod]

# Virtual environments
.venv/

# Notebook artifacts
.ipynb_checkpoints/

# analysis/ writes each figure twice: the PDF is the paper's, the PNG is a local check render
analysis/figures/**/*.png

.env

# Run outputs. The stripped logs that reproduce the paper's tables ARE tracked, so the
# artifact is self-contained; anything else a local run writes stays local.
logs/*
!logs/.gitkeep
!logs/loong/
!logs/corpusqa/
!logs/r3con/

# setuptools editable-install metadata (regenerated by `uv pip install -e .`)
*.egg-info/
# Local scratch notes (cluster/vLLM commands) — not part of the repo
help.txt

# per-method paper PDFs — kept locally, never tracked (by design)
evals/baselines/*/*.pdf

# Python build artifacts
build/
dist/
*.egg-info/

# macOS Finder metadata
.DS_Store

# Agent / working-process files — local only, not part of the artifact
CLAUDE.md
STATUS.md
AGENTS.md
.claude/
.cursor/
.aider*
